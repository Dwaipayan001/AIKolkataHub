# Server-only SMTP delivery settings. Never commit the real credentials.
# For Gmail, use smtp.gmail.com, port 465 (SSL) or 587 (STARTTLS),
# and an App Password (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sending-mailbox@gmail.com
SMTP_PASSWORD=your-16-character-app-password
CONTACT_FROM_EMAIL=your-sending-mailbox@gmail.com
CONTACT_TO_EMAIL=hellocodeadda@gmail.com
